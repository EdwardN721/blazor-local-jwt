@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            <ErrorBoundary>
                <ChildContent>
                    @Body 
                </ChildContent>
                <ErrorContent Context="excepcion">
                    <div class="alert alert-danger shadow-sm mt-3">
                        <h4 class="alert-heading">¡Ups! Excepción no controlada</h4>
                        <hr>
                        <p class="mb-0 font-monospace">@excepcion.Message</p>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>